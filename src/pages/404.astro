---
import Layout from '../layouts/Layout.astro';
---

<Layout title="No encontrada">
  <section class="wrap nf">
    <p class="eyebrow" style="color:var(--mostaza)">Error 404</p>
    <h1>Esta receta se ha quemado</h1>
    <p>La página que buscas no existe o ha cambiado de sitio.</p>
    <div style="display:flex;flex-wrap:wrap;gap:12px">
      <a href="/recetas" class="btn btn-tomate">Ver las recetas</a>
      <a href="/" class="btn btn-borde">Ir al inicio</a>
    </div>
  </section>
</Layout>

<style>
  .nf {
    padding-top: 80px;
    padding-bottom: 160px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  h1 {
    font-size: clamp(44px, 6vw, 72px);
    line-height: 1;
  }
  .nf > p:not(.eyebrow) {
    font-size: 19px;
    color: var(--crema-2);
  }
</style>
