---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { recetas, destacada, serie, categoriasConRecetas, slugify, cardColor, C } from '../lib/recetas.js';

const top = destacada();
const enSerie = serie();
const ultimas = recetas.filter((r) => r.slug !== top?.slug).slice(0, 6);
const cats = categoriasConRecetas();

// Experimentos que vienen; se sustituyen solos cuando publiques recetas de la serie
const proximos = [
  { title: 'Aguas de hierbas', text: 'Todo el sabor y el verde de la menta o la albahaca en un líquido.' },
  { title: 'Esferificaciones', text: 'Caviar de melón y perlas que explotan en la boca.' },
  { title: 'Desestructurar', text: 'La tortilla de patatas en vaso, por capas.' },
  { title: 'Espumas con sifón', text: 'Una espuma de patata caliente, sin complicarse.' },
];
const coloresSerie = [
  { bg: C.verde, fg: C.crema },
  { bg: C.crema, fg: C.tinta },
  { bg: C.mostaza, fg: C.tinta },
  { bg: C.tinta, fg: C.crema },
];
const tarjetas = [
  ...enSerie.map((r) => ({ title: r.title, text: r.desc, num: `#${r.serieNum}`, href: `/receta/${r.slug}`, photo: r.photo })),
  ...proximos
    .filter((p) => !enSerie.some((r) => r.title.toLowerCase().includes(p.title.toLowerCase().split(' ')[0])))
    .map((p) => ({ title: p.title, text: p.text, num: 'Pronto', href: null, photo: null })),
].slice(0, 4);

const ticker = ['Cocina curiosa', 'Food around the world', 'Aires', 'Masas', 'Salsas', 'Asiático', 'Postres', 'Probando cosas'];
---

<Layout>
  {
    top && (
      <section class="wrap hero">
        <div class="hero-txt">
          <p class="eyebrow" style="color:var(--mostaza)">
            {top.serie ? `Esta semana en la cocina · ${top.serie} #${top.serieNum}` : 'Lo último en la cocina'}
          </p>
          <h1 class="hero-h1">{top.title}</h1>
          {top.desc && <p class="hero-desc">{top.desc}</p>}
          <div class="hero-btns">
            <a href={`/receta/${top.slug}`} class="btn btn-tomate">
              Quiero hacerla
            </a>
            <a href="/recetas" class="btn btn-borde">
              Ver todas las recetas
            </a>
          </div>
        </div>
        <div class="hero-foto">
          <div class="hero-bloque" />
          <Photo src={top.photo} alt={top.title} class="hero-img" eager />
          {top.serie && (
            <div class="sticker hero-sticker" aria-hidden="true">
              <span>COCINA</span>
              <strong>#{top.serieNum}</strong>
              <span>CURIOSA</span>
            </div>
          )}
        </div>
      </section>
    )
  }

  <div class="cinta" aria-hidden="true">
    <div class="marquee">
      {
        [...ticker, ...ticker].map((w) => (
          <span class="cinta-item">
            {w}
            <i />
          </span>
        ))
      }
    </div>
  </div>

  <section class="serie">
    <div class="wrap serie-in">
      <div class="serie-head">
        <div style="display:flex;flex-direction:column;gap:12px;max-width:640px">
          <h2 class="serie-h2">Cocina curiosa</h2>
          <p style="font-size:18px;line-height:1.6">
            Veo algo de los grandes chefs, lo pruebo en mi cocina y te cuento qué tal salió, fallos incluidos. Si me sale a
            mí, te sale a ti.
          </p>
        </div>
        <a href="/cocina-curiosa" class="subrayado">Toda la serie</a>
      </div>
      <div class="pasos3">
        <div class="paso3"><span>1</span>Veo algo que hace un gran chef y me pica la curiosidad.</div>
        <div class="paso3"><span>2</span>Lo pruebo en mi cocina, con lo que tengo en casa.</div>
        <div class="paso3"><span>3</span>Te cuento cómo salió, fallos incluidos. Y una receta normal con ese toque.</div>
      </div>
      <div class="tarjetas">
        {
          tarjetas.map((t, i) => {
            const c = coloresSerie[i % coloresSerie.length];
            const Tag = t.href ? 'a' : 'div';
            return (
              <Tag
                href={t.href ?? undefined}
                class={t.href ? 'card tarjeta' : 'tarjeta'}
                style={`background:${c.bg};color:${c.fg}`}
              >
                <Photo src={t.photo} alt={t.title} bg="rgba(0,0,0,0.15)" fg={c.fg} style="height:200px;border-radius:12px" />
                <div class="t-head">
                  <span class="t-title">{t.title}</span>
                  <span class="t-num">{t.num}</span>
                </div>
                {t.text && <span class="t-text">{t.text}</span>}
              </Tag>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="wrap recetario">
    <div class="rec-head">
      <h2 style="font-size:44px">Del recetario</h2>
      <div class="chips">
        <a href="/recetas" class="chip">Todas</a>
        {
          cats.map((c) => (
            <a href={`/recetas/${slugify(c)}`} class="chip">
              {c}
            </a>
          ))
        }
      </div>
    </div>
    <div class="grid-cards">
      {ultimas.map((r, i) => <RecipeCard r={r} color={cardColor(i)} />)}
    </div>
    <div style="text-align:center;margin-top:48px">
      <a href="/recetas" class="btn btn-borde">Ver las {recetas.length} recetas</a>
    </div>
  </section>

  <section class="ig">
    <div class="wrap ig-in">
      <h2 style="font-size:36px">Lo que pasa en mi cocina</h2>
      <a href="https://www.instagram.com/toodarktocook/" class="subrayado" rel="me noopener">@toodarktocook en Instagram</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-top: 40px;
    padding-bottom: 96px;
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: center;
  }
  .hero-txt {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .hero-h1 {
    font-size: clamp(44px, 6vw, 72px);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .hero-desc {
    font-size: 19px;
    line-height: 1.6;
    color: var(--crema-2);
    max-width: 520px;
  }
  .hero-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-foto {
    flex: 1 1 520px;
    min-width: 0;
    position: relative;
    height: 600px;
  }
  .hero-bloque {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 72%;
    height: 78%;
    border-radius: 28px;
    background: var(--tomate);
  }
  .hero-foto :global(.hero-img) {
    position: absolute;
    left: 0;
    top: 0;
    width: 94% !important;
    height: 93%;
    border-radius: 24px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.25);
  }
  .hero-sticker {
    position: absolute;
    top: -18px;
    right: 4px;
    width: 136px;
    height: 136px;
    border-radius: 50%;
    background: var(--mostaza);
    color: var(--tinta);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: var(--display);
    font-weight: 700;
    line-height: 1.05;
    transform: rotate(-10deg);
  }
  .hero-sticker span {
    font-size: 12px;
    letter-spacing: 0.1em;
  }
  .hero-sticker strong {
    font-size: 34px;
  }
  .cinta {
    background: var(--mostaza);
    color: var(--tinta);
    overflow: hidden;
    white-space: nowrap;
    padding: 18px 0;
  }
  .marquee {
    display: inline-flex;
    gap: 36px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 26px;
    animation: slide 45s linear infinite;
  }
  .cinta-item {
    display: inline-flex;
    align-items: center;
    gap: 36px;
  }
  .cinta-item i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--tomate);
  }
  @keyframes slide {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  .serie {
    background: var(--tomate);
    color: var(--tinta);
    padding: 88px 0;
  }
  .serie-in {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .serie-head,
  .rec-head,
  .ig-in {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: flex-end;
  }
  .serie-h2 {
    font-size: clamp(48px, 6vw, 72px);
    line-height: 1;
  }
  .subrayado {
    font-weight: 600;
    border-bottom: 2px solid currentColor;
    padding-bottom: 2px;
  }
  .pasos3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .paso3 {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: rgba(30, 27, 23, 0.12);
    border-radius: 18px;
    padding: 20px;
    font-size: 16px;
    line-height: 1.45;
    font-weight: 500;
  }
  .paso3 span {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--tinta);
    color: var(--mostaza);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
  }
  .tarjetas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
  }
  :global(.tarjeta) {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-radius: 20px;
    padding: 16px 16px 26px;
  }
  .t-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    padding: 4px 6px 0;
  }
  .t-title {
    min-width: 0;
    overflow-wrap: anywhere;
    font-family: var(--display);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.15;
  }
  .t-num {
    font-family: var(--display);
    font-size: 22px;
    font-weight: 700;
    opacity: 0.55;
    white-space: nowrap;
  }
  .t-text {
    font-size: 15px;
    line-height: 1.5;
    padding: 0 6px;
  }
  .recetario {
    padding-top: 88px;
    padding-bottom: 88px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .ig {
    background: var(--mostaza);
    color: var(--tinta);
    padding: 56px 0;
  }
  @media (max-width: 640px) {
    .hero-foto {
      height: 380px;
    }
    .hero-sticker {
      width: 104px;
      height: 104px;
    }
    .hero-sticker strong {
      font-size: 26px;
    }
  }
</style>
