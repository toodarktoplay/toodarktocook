---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
}

const {
  title,
  description = 'Recetas de casa con un toque curioso. Food around the world.',
  image = null,
} = Astro.props;
const fullTitle = title ? `${title} · Too Dark to Cook` : 'Too Dark to Cook · Food around the world';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || '/img/logo/instagram-gato-bol-1080.png', Astro.site).href;
const path = Astro.url.pathname;
const activo = (p: string) => (path === p || path.startsWith(p + '/') ? 'activo' : '');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#34503A" />
    <slot name="head" />
  </head>
  <body>
    <header class="wrap top">
      <a href="/" class="logo marca" aria-label="Too Dark to Cook, inicio"><img src="/img/logo/gato-cara.svg" alt="" width="48" height="48" />TOO DARK TO COOK</a>
      <nav aria-label="Principal">
        <a href="/recetas" class={activo('/recetas')}>Recetas</a>
        <a href="/sobre-mi" class={activo('/sobre-mi')}>Sobre mí</a>
        <a href="/cocina-curiosa" class="nav-serie">Cocina curiosa</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pie">
      <div class="wrap pie-in">
        <div class="pie-marca">
          <span class="pie-logo"><img src="/img/logo/gato-bol.svg" alt="" width="72" height="72" /><span class="logo">TOO DARK TO COOK</span></span>
          <span class="pie-lema">Food around the world</span>
        </div>
        <div class="pie-links">
          <a href="https://www.instagram.com/toodarktocook/" rel="me noopener">Instagram · @toodarktocook</a>
          <span>© {new Date().getFullYear()} Salva</span>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .top {
    padding-top: 24px;
    padding-bottom: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    font-family: var(--display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 0.08em;
  }
  .marca {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .marca img {
    width: 48px;
    height: 48px;
    flex: none;
  }
  .pie-logo {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .pie-logo img {
    width: 72px;
    height: 72px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    align-items: center;
    font-size: 15px;
    font-weight: 500;
  }
  nav a.activo {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }
  .nav-serie {
    background: var(--mostaza);
    color: var(--tinta);
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 999px;
  }
  .pie {
    background: rgba(0, 0, 0, 0.28);
    padding: 48px 0;
    margin-top: 0;
  }
  .pie-in {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    justify-content: space-between;
    align-items: center;
  }
  .pie-marca {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pie-marca .logo {
    font-size: 16px;
  }
  .pie-lema,
  .pie-links {
    font-size: 14px;
    color: var(--crema-2);
  }
  .pie-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
</style>
